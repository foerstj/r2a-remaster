[t:template,n:bo_bo_le_light_base]  // = bo_bo_le_light
{
	doc = "Light Boots";
	specializes = base_boot;
	[common]
	{
		is_pcontent_allowed = false;
		screen_name = "Light Boots";
	}
	[defend]
	{
		armor_style = 068;
		armor_type = type1;
		defense = 0;
	}
	[gui]
	{
		inventory_height = 2;
		inventory_icon = b_gui_ig_i_a_boot_068;
		inventory_width = 1;
	}
}
[t:template,n:bo_bo_le_light_invisible]
{
	specializes = bo_bo_le_light_base;

	// Make them boots invisible in such a way that it even works when the actor gets deleted with a WE_REQ_DELETE
	[aspect]
	{
        force_no_render = true;
		is_visible	 = false;
        is_selectable = false;
	}
}
